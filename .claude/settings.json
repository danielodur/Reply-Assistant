{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run desktop:dev)",
      "Bash(npm run dev:web)",
      "Bash(npm run dev:api)",
      "Bash(npm run build)",
      "Bash(npm run build:web)",
      "Bash(npm run build:electron)",
      "Bash(npm run electron:build)",
      "Bash(npm run electron:watch)",
      "Bash(npm run preview)",
      "Bash(npm run verify:*)",
      "Bash(npm run verify*)",
      "Bash(npm run verify*)",
      "Bash(npm run build --workspace=apps/web)",
      "Bash(npm run build --workspace=apps/api)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm ls:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(node scripts/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git stash list)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(kill-port:*)",
      "Bash(lsof -i:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(npm publish:*)",
      "Bash(electron-builder:*)",
      "Bash(npm run desktop:pack)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/api/.env)",
      "Read(./apps/api/.env.*)",
      "Read(./apps/web/.env)",
      "Read(./apps/web/.env.*)",
      "Read(./supabase/.env)",
      "Read(./supabase/.env.*)",
      "Read(./netlify-auth/.env)",
      "Read(./netlify-auth/.env.*)"
    ]
  }
}
