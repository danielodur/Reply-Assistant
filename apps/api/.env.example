# ════════════════════════════════════════════════════════════════════════════════
# REPLY ASSISTANT — API Server Environment Variables  (SAFE TO COMMIT)
# Copy this file to .env and replace every placeholder with your real key.
# ════════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Supabase (backend) ───────────────────────────────────────────────────────
# Fresh project: see supabase/FRESH_PROJECT_SETUP.md
# SUPABASE_DB_URL: use Connection string from Supabase Dashboard (pooler or direct).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_DATABASE_PASSWORD=YOUR_DB_PASSWORD
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Active provider — change to switch AI backend
# Runtime options in server.js: deepseek | openai | zhipu | qwen | moonshot
AI_PROVIDER=deepseek

# ── Webhook scaffolds (optional) ───────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Azure OpenAI China (Mooncake — works inside China) ───────────────────────
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── OCR / Upload processing ────────────────────────────────────────────────────
GOOGLE_VISION_API_KEY=...
GOOGLE_APPLICATION_CREDENTIALS=
# ALIYUN_OCR_LOGIN=your-ram-user@YOUR_ACCOUNT.onaliyun.com
ALIYUN_OCR_ACCESS_KEY_ID=...
ALIYUN_OCR_ACCESS_KEY_SECRET=...
ALIYUN_OCR_REGION=cn-hangzhou
AZURE_COMPUTER_VISION_ENDPOINT=
AZURE_COMPUTER_VISION_KEY=

# ── DeepSeek (OpenAI-compatible, China-native) ────────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Zhipu AI / GLM (智谱AI, OpenAI-compatible) ────────────────────────────────
ZHIPU_API_KEY=...
ZHIPU_MODEL=glm-4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Alibaba Qwen / DashScope (通义千问, OpenAI-compatible mode) ────────────────
QWEN_API_KEY=...
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Moonshot AI / Kimi (OpenAI-compatible) ────────────────────────────────────
MOONSHOT_API_KEY=...
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ── Baidu ERNIE / Wenxin (文心一言) — requires API Key + Secret Key ───────────
ERNIE_API_KEY=...
ERNIE_SECRET_KEY=...
ERNIE_MODEL=ERNIE-4.0-8K

# ── ByteDance Doubao / Volcano Engine (豆包, OpenAI-compatible) ───────────────
DOUBAO_API_KEY=...
DOUBAO_MODEL=ep-YOUR_ENDPOINT_ID
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── MiniMax ───────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=...
MINIMAX_GROUP_ID=...
MINIMAX_MODEL=abab6.5s-chat
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# ── 01.AI / Yi (零一万物, OpenAI-compatible) ─────────────────────────────────
YI_API_KEY=...
YI_MODEL=yi-large
YI_BASE_URL=https://api.lingyiwanwu.com/v1
