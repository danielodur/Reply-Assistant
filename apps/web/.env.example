# ════════════════════════════════════════════════════════════════════════════════
# REPLY ASSISTANT — Electron Desktop Renderer  (SAFE TO COMMIT)
# Fresh project: see supabase/FRESH_PROJECT_SETUP.md
# Copy to apps/web/.env. Only PUBLIC-SAFE VITE_* values belong here.
# NOT for a public website. Run: npm run desktop:dev
#
# Secrets (AI, OCR, Supabase service role) → apps/api/.env only.
# ════════════════════════════════════════════════════════════════════════════════

VITE_APP_TARGET=desktop

VITE_APP_PROFILE_NAME=New User
VITE_APP_PROFILE_USER_ID=
VITE_APP_PROFILE_REFERRAL_CODE=RA-5266-95051

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Netlify auth callback site (no trailing slash). Must match Supabase redirect URLs.
# Example: https://reply-assistant.netlify.app or https://your-site-name.netlify.app
VITE_AUTH_SITE_URL=https://reply-assistant.netlify.app

# VITE_API_PROXY_TARGET=http://localhost:4011

VITE_APP_ENV=development
