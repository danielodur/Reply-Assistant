# ════════════════════════════════════════════════════════════════════════════════
# REPLY ASSISTANT — Electron Main Process  (SAFE TO COMMIT)
#
# Optional overrides for the desktop shell (electron/main.ts).
# npm run desktop:dev already sets ELECTRON_RENDERER_URL in the launch command.
# Copy to electron/.env only if you want persistent local overrides.
# No secrets belong here.
# ════════════════════════════════════════════════════════════════════════════════

# Dev renderer URL (Vite dev server for the desktop UI)
ELECTRON_RENDERER_URL=http://localhost:5190

# Open DevTools on launch when true
ELECTRON_DEBUG=false
